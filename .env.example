# Copy this file to ".env" to preload credentials instead of typing them
# into the sidebar every run. Every value here is optional -- you can
# paste a key straight into the sidebar at runtime instead.
#
# You only need credentials for the provider(s) you actually use.

# --- OpenAI -----------------------------------------------------------
OPENAI_API_KEY=sk-...

# Optional: override the default OpenAI model.
OPENAI_MODEL=gpt-4o-mini

# Optional: only for an OpenAI-compatible proxy / Azure OpenAI gateway.
# OPENAI_BASE_URL=https://your-proxy.example.com/v1

# --- Claude (API key) -------------------------------------------------
# From console.anthropic.com. NOTE: a claude.ai Pro/Max subscription does
# NOT include API credits -- this key is billed separately. To use your
# subscription instead, pick "Claude (subscription)" in the sidebar; it
# needs no key at all, just the Claude Code CLI signed in.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Groq -------------------------------------------------------------
# From console.groq.com. Has a free tier.
# GROQ_API_KEY=gsk_...

# --- Startup provider -------------------------------------------------
# Which provider the app opens on: openai | anthropic | claude_code | groq
# SP2PY_PROVIDER=openai
