# Streamlit secrets -- the hosted equivalent of ".env".
#
# Locally: copy this file to ".streamlit/secrets.toml" (gitignored).
# On Streamlit Community Cloud: paste these lines into
# Manage app -> Settings -> Secrets. Never commit the real file.
#
# Every value is optional. With none set, the app still works -- you just
# paste a key into the sidebar each session. Set only the provider(s) you
# use.

# --- OpenAI -----------------------------------------------------------
# OPENAI_API_KEY = "sk-..."
# OPENAI_MODEL = "gpt-4o-mini"
# OPENAI_BASE_URL = "https://your-proxy.example.com/v1"

# --- Claude (API key, billed separately from a claude.ai subscription) -
# ANTHROPIC_API_KEY = "sk-ant-..."

# --- Groq (free tier available) ---------------------------------------
# GROQ_API_KEY = "gsk_..."

# --- Startup provider: openai | anthropic | claude_code | groq --------
# SP2PY_PROVIDER = "openai"
#
# Note: "claude_code" (Claude via subscription) needs the Claude Code CLI
# on PATH and cannot work on Community Cloud -- local use only.
